{
  "manifest_version": 3,
  "name": "哔哩哔哩 Cookies 登录助手",
  "version": "1.0.0",
  "description": "通过导入 Cookies 快速登录哔哩哔哩网页端，支持一键写入 Cookie 并自动刷新登录。",
  "permissions": [
    "cookies",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.bilibili.com/*",
    "http://*.bilibili.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "哔哩哔哩 Cookies 登录助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}